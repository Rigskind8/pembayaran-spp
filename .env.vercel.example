# ==========================================
# VERCEL ENVIRONMENT VARIABLES CONFIGURATION
# Copy variable-variable ini ke Dashboard Vercel:
# Project Settings -> Environment Variables
# ==========================================

APP_NAME="Pembayaran SPP"
APP_ENV=production
APP_KEY=base64:FNJVa5Y2G6nmxSH+I2DXk6SOsRhGmaCygklTuSbHqAw=
APP_DEBUG=false
APP_URL=https://pembayaran-spp.vercel.app

# Wajib untuk Vercel Serverless (karena filesystem read-only kecuali /tmp)
LOG_CHANNEL=stderr
CACHE_STORE=array
SESSION_DRIVER=cookie

# ==========================================
# DATABASE CLOUD (PENTING!)
# Vercel tidak bisa mengakses localhost (127.0.0.1) komputer Anda.
# Gunakan Cloud MySQL gratis (misal: TiDB Cloud / Aiven / Railway):
# ==========================================
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=pembayaran_spp
DB_USERNAME=root
DB_PASSWORD=your_cloud_db_password
