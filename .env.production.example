APP_NAME=PembayaranSPP
APP_ENV=production
APP_KEY=base64:GENERATE_ME
APP_DEBUG=false
APP_URL=https://your-app.onrender.com

DB_CONNECTION=pgsql
DB_HOST=YOUR_PG_HOST
DB_PORT=5432
DB_DATABASE=YOUR_PG_DATABASE
DB_USERNAME=YOUR_PG_USER
DB_PASSWORD=YOUR_PG_PASSWORD

SESSION_DRIVER=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=s3

LOG_CHANNEL=stack
LOG_LEVEL=error

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=YOUR_BUCKET
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Notes:
# - Do NOT commit real secrets. Use Render dashboard to set secret env vars.
# - Replace APP_KEY with the value generated by `php artisan key:generate --show`.